<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x86</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<!-- zkemkeeper (ZKTeco COM, GUID fe9ded34-e159-408e-8490-b720a5e632c7) için tlbimp çıktısı.
		     Derleme COM kaydı gerektirmez (CI/yeni geliştirici); çalışma anında cihaz SDK'sı yine kayıtlı olmalı. -->
		<Reference Include="Interop.zkemkeeper">
			<HintPath>Lib\Interop.zkemkeeper.dll</HintPath>
			<EmbedInteropTypes>true</EmbedInteropTypes>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
		<!-- SqlClient gecisli olarak acikli surum ceker (CVE-2026-84008/70162); yamali surume sabitlendi -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Migrations\" />
		<Folder Include="wwwroot\uploads\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OgrenciBilgiSistemi.Shared\OgrenciBilgiSistemi.Shared.csproj" />
		<ProjectReference Include="..\OgrenciBilgiSistemi.Sms\OgrenciBilgiSistemi.Sms.csproj" />
		<ProjectReference Include="..\OgrenciBilgiSistemi.Push\OgrenciBilgiSistemi.Push.csproj" />
	</ItemGroup>

</Project>
