@using System.Globalization
@model OgrenciBilgiSistemi.ViewModels.AidatRaporVm

@{
    ViewData["Title"] = "Öğrenci Aidat İşlemleri";

    // Sayfalı liste
    var list = Model.Satirlar;

    string Fmt(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
    var culture = CultureInfo.CurrentCulture;

    // 🔹 Sayfa içi toplamlar (yalnızca listelenen satırlar)
    var pageToplamBorc = list?.Sum(s => s.BorcGosterim) ?? 0m;
    var pageToplamOdenen = list?.Sum(s => s.GosterilenOdenen) ?? 0m;
    var pageToplamKalan = list?.Sum(s => s.Kalan) ?? 0m;
}

<div class="viewport-scroller">
    <div class="fixed-canvas">
        <div class="card border rounded-4 p-4 mt-4">

            <!-- Başlık + aksiyonlar -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-nowrap no-wrap-scroll">
                <h3 class="text-primary fw-bold mb-0">@ViewData["Title"]</h3>

                <a class="btn btn-success fw-semibold"
                   asp-controller="Aidat"
                   asp-action="AidatRaporExcel"
                   asp-route-query="@Model.query"
                   asp-route-yil="@(Model.yil)"
                   asp-route-birimId="@Model.birimId"
                   asp-route-durum="@((int)Model.durum)"
                   asp-route-bas="@Fmt(Model.bas)"
                   asp-route-bit="@Fmt(Model.bit)"
                   asp-route-includePasif="@(Model.includePasif)">
                    <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
                </a>
            </div>

            <!-- Filtre Formu -->
            <form id="raporFilterForm" method="get"
                  asp-controller="Aidat" asp-action="Index"
                  class="d-flex align-items-end gap-3 flex-nowrap no-wrap-scroll w-100 bg-body-tertiary border rounded-3 p-3 mb-3">

                <!-- Öğrenci Arama -->
                <div>
                    <label for="query" class="visually-hidden">Öğrenci</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input asp-for="query" id="query" class="form-control"
                               placeholder="Ad/soyad veya numara…" style="width:280px;" />
                    </div>
                </div>

                <!-- Yıl -->
                <div>
                    <label for="yil" class="visually-hidden">Yıl</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-calendar2-week"></i></span>
                        <select asp-for="yil" id="yil" asp-items="Model.Yillar"
                                class="form-select" style="width:160px;"></select>
                    </div>
                </div>

                <!-- Birim -->
                <div>
                    <label for="birimId" class="visually-hidden">Birim</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-diagram-3"></i></span>
                        <select asp-for="birimId" id="birimId" asp-items="Model.Birimler"
                                class="form-select" style="width:190px;"></select>
                    </div>
                </div>

                <!-- Durum -->
                <div>
                    <label for="durum" class="visually-hidden">Durum</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-funnel"></i></span>
                        <select asp-for="durum" id="durum" asp-items="Model.Durumlar"
                                class="form-select" style="width:170px;"></select>
                    </div>
                </div>

                <!-- Ara -->
                <div class="ms-auto">
                    <button class="btn btn-primary px-3 text-nowrap" type="submit">
                        <i class="bi bi-search me-1"></i> Ara
                    </button>
                </div>
            </form>

            <!-- Seçili yılın tarifesi (tüm öğrenciler için geçerli) -->
            @{
                var tarifeYil = Model.yil ?? 0;
            }
            <div class="d-flex justify-content-between align-items-center border rounded-3 p-3 mb-3 @(Model.Tarife is null ? "border-warning bg-warning-subtle" : "")">
                <div>
                    <span class="fw-semibold">@tarifeYil-@(tarifeYil + 1) Tarifesi:</span>
                    @if (Model.Tarife is not null)
                    {
                        <span class="fs-5 ms-1">@Model.Tarife.Tutar.ToString("C", culture)</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Tarife.Aciklama))
                        {
                            <span class="text-muted ms-2">(@Model.Tarife.Aciklama)</span>
                        }
                    }
                    else
                    {
                        <span class="ms-1">Tanımlı değil — öğrenci borçları 0 görünür.</span>
                    }
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#tarifeModal">
                    <i class="bi bi-pencil"></i> @(Model.Tarife is null ? "Tarife Tanımla" : "Tarifeyi Düzenle")
                </button>
            </div>

            <!-- Liste -->
            @if (list == null || !list.Any())
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i> Kayıt bulunamadı.
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="table table-hover table-sm align-middle">
                        <thead class="bg-dark text-white">
                            <tr class="text-center">
                                <th class="text-start">Öğrenci</th>
                                <th>Öğrenci No</th>
                                <th>Sınıf</th>
                                <th class="text-end">Borç</th>
                                <th class="text-end">Ödenen</th>
                                <th class="text-end">Kalan</th>
                                <th>Durum</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in list)
                            {
                                string badgeText;
                                string badgeClass;
                                if (s.Muaf) { badgeText = "Muaf"; badgeClass = "bg-warning text-dark"; }
                                else if (s.Kapandi) { badgeText = "Kapalı"; badgeClass = "bg-success text-white"; }
                                else { badgeText = "Açık"; badgeClass = "bg-danger text-white"; }

                                <tr class="text-center">
                                    <td class="text-start">
                                        <a asp-controller="Aidat"
                                           asp-action="Ozet"
                                           asp-route-ogrenciId="@s.OgrenciId"
                                           asp-route-yil="@(s.Yil ?? Model.yil)"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                           class="text-decoration-none">
                                            @s.OgrenciAdSoyad
                                        </a>
                                    </td>
                                    <td>@s.OgrenciNo</td>
                                    <td>@s.OgrenciSinif</td>
                                    <td class="text-end">@s.BorcGosterim.ToString("C", culture)</td>
                                    <td class="text-end">@s.GosterilenOdenen.ToString("C", culture)</td>
                                    <td class="text-end">@s.Kalan.ToString("C", culture)</td>
                                    <td><span class="badge @badgeClass">@badgeText</span></td>
                                    <td>
                                        <a asp-controller="Aidat"
                                           asp-action="Ozet"
                                           asp-route-ogrenciId="@s.OgrenciId"
                                           asp-route-yil="@(s.Yil ?? Model.yil)"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-info-circle"></i> Detay
                                        </a>
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#odemeEkleModal"
                                                data-ogrenciid="@s.OgrenciId"
                                                data-ogrenciad="@s.OgrenciAdSoyad"
                                                data-yil="@Model.yil"
                                                data-returnurl="@(Context.Request.Path + Context.Request.QueryString)"
                                                disabled="@(s.Muaf ? "disabled" : null)"
                                                title="@(s.Muaf ? "Muaf öğrenciye ödeme eklenemez" : null)">
                                            Ödeme Ekle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Sayfalama (sadece Önceki / Sonraki + özet) -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        Toplam <strong>@list.ToplamSayi</strong> kayıt •
                        Sayfa <strong>@list.SayfaIndeks</strong>/<strong>@list.ToplamSayfa</strong>
                    </div>
                    <div class="btn-group btn-group-gap">
                        <a class="btn btn-outline-secondary @(list.OncekiSayfaVar ? "" : "disabled")"
                           asp-action="Index"
                           asp-route-query="@Model.query"
                           asp-route-yil="@(Model.yil)"
                           asp-route-birimId="@Model.birimId"
                           asp-route-durum="@((int)Model.durum)"
                           asp-route-bas="@(Model.bas?.ToString("yyyy-MM-dd"))"
                           asp-route-bit="@(Model.bit?.ToString("yyyy-MM-dd"))"
                           asp-route-includePasif="@(Model.includePasif)"
                           asp-route-page="@(list.SayfaIndeks - 1)"
                           asp-route-pageSize="@list.SayfaBoyutu">
                            ‹ Önceki
                        </a>

                        <a class="btn btn-outline-secondary @(list.SonrakiSayfaVar ? "" : "disabled")"
                           asp-action="Index"
                           asp-route-query="@Model.query"
                           asp-route-yil="@(Model.yil)"
                           asp-route-birimId="@Model.birimId"
                           asp-route-durum="@((int)Model.durum)"
                           asp-route-bas="@(Model.bas?.ToString("yyyy-MM-dd"))"
                           asp-route-bit="@(Model.bit?.ToString("yyyy-MM-dd"))"
                           asp-route-includePasif="@(Model.includePasif)"
                           asp-route-page="@(list.SayfaIndeks + 1)"
                           asp-route-pageSize="@list.SayfaBoyutu">
                            Sonraki ›
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_OdemeEkleModal", new OgrenciBilgiSistemi.Dtos.AidatOdemeEkleDto())

<!-- Tarife Modal -->
<div class="modal fade" id="tarifeModal" tabindex="-1" aria-labelledby="tarifeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form method="post" asp-action="TarifeKaydet" asp-controller="Aidat">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Yil" value="@(Model.yil)" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />

                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="tarifeModalLabel">@(Model.yil)-@(Model.yil + 1) Tarifesi</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info small">
                        Tarife <strong>tüm öğrenciler</strong> için geçerlidir. Öğrenciye özel tutarı olanlar ve muaflar etkilenmez.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tutar</label>
                        <input type="text" name="Tutar" inputmode="decimal" class="form-control" required
                               value="@(Model.Tarife?.Tutar.ToString("0.##", culture))" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <input type="text" name="Aciklama" maxlength="200" class="form-control" value="@Model.Tarife?.Aciklama" />
                    </div>

                    @if (Model.Tarife is not null && Model.OdemesiOlanSayisi > 0)
                    {
                        <div class="alert alert-warning small mb-0">
                            <div class="mb-2">
                                Bu yıl ödeme yapmış <strong>@Model.OdemesiOlanSayisi</strong> öğrencinin borcu yeni tarifeye göre değişecek.
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="OdeyenleriSabitle" value="true" id="odeyenleriSabitle" />
                                <label class="form-check-label" for="odeyenleriSabitle">
                                    Ödemesi olan öğrencileri eski tutarda (@Model.Tarife.Tutar.ToString("C", culture)) sabitle
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const odemeModal = document.getElementById('odemeEkleModal');
        odemeModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('odm-ogrenciId').value = btn.getAttribute('data-ogrenciid');
            document.getElementById('odm-ogrenciAd').value  = btn.getAttribute('data-ogrenciad') || '';
            document.getElementById('odm-returnUrl').value  = btn.getAttribute('data-returnurl') || '';
            document.getElementById('odm-yil').value        = btn.getAttribute('data-yil') || '@Model.yil';
        });
    </script>
}