@model OgrenciBilgiSistemi.ViewModels.ServisFormVm

@{
    var action = Model.FormAction;
    var submitText = Model.SubmitText;
    var isEkle = action == "Ekle";
}

<div class="viewport-scroller">
    <div class="fixed-canvas">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-6">
                    <div class="card rounded-3 border">
                        <div class="card-header bg-primary text-white text-center">
                            <h4 class="fw-bold mb-0">
                                @(isEkle ? "Servis Ekle" : "Servis Güncelle")
                            </h4>
                        </div>

                        <div class="card-body p-4">
                            <form method="post" asp-action="@action" autocomplete="off">
                                @Html.AntiForgeryToken()

                                @if (!isEkle)
                                {
                                    <input type="hidden" asp-for="KullaniciId" />
                                }

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <!-- Kullanıcı Adı -->
                                <div class="mb-3">
                                    <label asp-for="KullaniciAdi" class="form-label fw-semibold"></label>
                                    <input asp-for="KullaniciAdi" class="form-control" required minlength="3"
                                           placeholder="Kullanıcı adı giriniz" />
                                    <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
                                </div>

                                <!-- Şifre -->
                                <div class="mb-3">
                                    <label asp-for="Sifre" class="form-label fw-semibold"></label>
                                    @if (isEkle)
                                    {
                                        <input asp-for="Sifre" type="password" class="form-control"
                                               required minlength="3" placeholder="Şifre giriniz" />
                                    }
                                    else
                                    {
                                        <input asp-for="Sifre" type="password" class="form-control"
                                               data-val="false" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                                        <small class="text-muted">Boş bırakırsanız mevcut şifre korunur.</small>
                                    }
                                    <span asp-validation-for="Sifre" class="text-danger"></span>
                                </div>

                                <!-- Plaka -->
                                <div class="mb-3">
                                    <label asp-for="Plaka" class="form-label fw-semibold"></label>
                                    <input asp-for="Plaka" class="form-control" required placeholder="34 ABC 123" />
                                    <span asp-validation-for="Plaka" class="text-danger"></span>
                                </div>

                                <hr class="my-3" />
                                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-badge"></i> Şoför Bilgileri</h6>

                                <!-- Şoför Adı Soyadı -->
                                <div class="mb-3">
                                    <label asp-for="SoforAdSoyad" class="form-label fw-semibold"></label>
                                    <input asp-for="SoforAdSoyad" class="form-control" maxlength="100" placeholder="Şoför adı soyadı" />
                                    <span asp-validation-for="SoforAdSoyad" class="text-danger"></span>
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Şoför TC -->
                                    <div class="col-sm-6">
                                        <label asp-for="SoforTcKimlikNo" class="form-label fw-semibold"></label>
                                        <input asp-for="SoforTcKimlikNo" class="form-control" maxlength="11" inputmode="numeric" placeholder="11 haneli" />
                                        <span asp-validation-for="SoforTcKimlikNo" class="text-danger"></span>
                                    </div>
                                    <!-- Şoför Telefon -->
                                    <div class="col-sm-6">
                                        <label asp-for="Telefon" class="form-label fw-semibold"></label>
                                        <input asp-for="Telefon" class="form-control" inputmode="numeric" placeholder="5XXXXXXXXX" />
                                        <span asp-validation-for="Telefon" class="text-danger"></span>
                                    </div>
                                </div>

                                <hr class="my-3" />
                                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-heart"></i> Hostes Bilgileri</h6>

                                <!-- Hostes Adı Soyadı -->
                                <div class="mb-3">
                                    <label asp-for="HostesAdSoyad" class="form-label fw-semibold"></label>
                                    <input asp-for="HostesAdSoyad" class="form-control" maxlength="100" placeholder="Hostes adı soyadı" />
                                    <span asp-validation-for="HostesAdSoyad" class="text-danger"></span>
                                </div>

                                <div class="row g-2 mb-3">
                                    <!-- Hostes TC -->
                                    <div class="col-sm-6">
                                        <label asp-for="HostesTcKimlikNo" class="form-label fw-semibold"></label>
                                        <input asp-for="HostesTcKimlikNo" class="form-control" maxlength="11" inputmode="numeric" placeholder="11 haneli" />
                                        <span asp-validation-for="HostesTcKimlikNo" class="text-danger"></span>
                                    </div>
                                    <!-- Hostes Telefon -->
                                    <div class="col-sm-6">
                                        <label asp-for="HostesTelefon" class="form-label fw-semibold"></label>
                                        <input asp-for="HostesTelefon" class="form-control" inputmode="numeric" placeholder="5XXXXXXXXX" />
                                        <span asp-validation-for="HostesTelefon" class="text-danger"></span>
                                    </div>
                                </div>

                                @if (!isEkle)
                                {
                                    <!-- Durum -->
                                    <div class="mb-3">
                                        <label asp-for="IsDeleted" class="form-label fw-semibold"></label>
                                        <select asp-for="IsDeleted" class="form-select">
                                            <option value="false">Aktif</option>
                                            <option value="true">Pasif</option>
                                        </select>
                                        <span asp-validation-for="IsDeleted" class="text-danger"></span>
                                    </div>
                                }

                                <!-- Butonlar -->
                                <div class="d-flex justify-content-between gap-2">
                                    <a asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Geri Dön
                                    </a>
                                    <button type="submit" class="btn btn-primary fw-bold">
                                        <i class="bi bi-save"></i> @submitText
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
