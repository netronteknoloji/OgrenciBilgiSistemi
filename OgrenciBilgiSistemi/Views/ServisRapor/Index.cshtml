@model OgrenciBilgiSistemi.ViewModels.ServisRaporVm
@using OgrenciBilgiSistemi.Shared.Constants
@using OgrenciBilgiSistemi.ViewModels

@{
    ViewData["Title"] = "Servis Şoför Raporu";
    var sekme = Model.Sekme;
    var q = Model.AramaMetni;
    var servisSozluk = Model.Servisler.ToDictionary(s => s.KullaniciId);
    bool servisFiltresi = sekme != ServisRaporSekme.Soforler;
    bool tarihFiltresi = sekme == ServisRaporSekme.Yoklama;

    string aramaIpucu = sekme switch
    {
        ServisRaporSekme.Ogrenciler => "Öğrenci adı veya numarası…",
        ServisRaporSekme.Yoklama => "Öğrenci adı…",
        _ => "Plaka, şoför veya hostes ara…"
    };
}

<div class="viewport-scroller">
    <div class="fixed-canvas">
        <div class="card border rounded-4 p-4 mt-4">

            <!-- Başlık + aksiyonlar -->
            <div class="d-flex gap-2 justify-content-between align-items-center mb-3 flex-nowrap no-wrap-scroll">
                <h3 class="text-primary fw-bold mb-0">@ViewData["Title"]</h3>

                <a class="btn btn-success fw-semibold"
                   asp-action="Excel"
                   asp-route-sekme="@sekme"
                   asp-route-servisId="@Model.ServisId"
                   asp-route-searchString="@q"
                   asp-route-startDate="@Model.StartDate"
                   asp-route-endDate="@Model.EndDate">
                    <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
                </a>
            </div>

            <!-- Sekmeler -->
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link @(sekme == ServisRaporSekme.Soforler ? "active fw-semibold" : "")"
                       asp-action="Index" asp-route-sekme="@ServisRaporSekme.Soforler">
                        <i class="bi bi-person-badge"></i> Şoför Listesi
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(sekme == ServisRaporSekme.Ogrenciler ? "active fw-semibold" : "")"
                       asp-action="Index" asp-route-sekme="@ServisRaporSekme.Ogrenciler">
                        <i class="bi bi-people"></i> Şoför-Öğrenci Listesi
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(sekme == ServisRaporSekme.Yoklama ? "active fw-semibold" : "")"
                       asp-action="Index" asp-route-sekme="@ServisRaporSekme.Yoklama">
                        <i class="bi bi-clipboard-check"></i> Servis Yoklaması
                    </a>
                </li>
            </ul>

            <!-- Filtre Formu -->
            <form method="get" asp-action="Index"
                  class="d-flex align-items-end gap-3 flex-nowrap no-wrap-scroll w-100 bg-body-tertiary border rounded-3 p-3 mb-3">
                <input type="hidden" name="sekme" value="@sekme" />

                <div class="input-group" style="max-width:320px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@q" class="form-control" placeholder="@aramaIpucu" />
                </div>

                @if (servisFiltresi)
                {
                    <div class="input-group" style="max-width:280px;">
                        <span class="input-group-text bg-white"><i class="bi bi-bus-front"></i></span>
                        <select name="servisId" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(Model.ServisId == null)">Tüm Servisler</option>
                            @foreach (var s in Model.Servisler)
                            {
                                <option value="@s.KullaniciId" selected="@(Model.ServisId == s.KullaniciId)">
                                    @s.Plaka — @(s.SoforAdSoyad ?? s.Kullanici?.KullaniciAdi)
                                </option>
                            }
                        </select>
                    </div>
                }

                @if (tarihFiltresi)
                {
                    <div class="input-group" style="max-width:200px;">
                        <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                        <input name="startDate" type="date" value="@Model.StartDate" class="form-control" />
                    </div>
                    <div class="input-group" style="max-width:200px;">
                        <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                        <input name="endDate" type="date" value="@Model.EndDate" class="form-control" />
                    </div>
                }

                <button class="btn btn-primary ms-auto px-3 text-nowrap" type="submit">
                    <i class="bi bi-search me-1"></i> Ara
                </button>
            </form>

            @if (sekme == ServisRaporSekme.Soforler)
            {
                @if (!Model.Soforler.Any())
                {
                    <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Kayıt bulunamadı.</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="table table-hover table-sm align-middle text-center">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th class="text-start">Plaka</th>
                                    <th>Servis Kullanıcı</th>
                                    <th>Şoför</th>
                                    <th>Şoför Tel</th>
                                    <th>Hostes</th>
                                    <th>Hostes Tel</th>
                                    <th>Öğrenci</th>
                                    <th>Evrak</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Soforler)
                                {
                                    <tr>
                                        <td class="text-start fw-semibold text-primary">@s.Plaka</td>
                                        <td>@(s.Kullanici?.KullaniciAdi ?? "-")</td>
                                        <td>@(s.SoforAdSoyad ?? "-")</td>
                                        <td>@(s.Kullanici?.Telefon ?? "-")</td>
                                        <td>@(s.HostesAdSoyad ?? "-")</td>
                                        <td>@(s.HostesTelefon ?? "-")</td>
                                        <td>
                                            <a asp-action="Index" asp-route-sekme="@ServisRaporSekme.Ogrenciler" asp-route-servisId="@s.KullaniciId"
                                               class="badge bg-info text-decoration-none">@s.OgrenciSayisi</a>
                                        </td>
                                        <td>
                                            @if (s.EvrakTamMi)
                                            {
                                                <span class="badge bg-success">Tam</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark" title="@s.EksikEvraklar">Eksik</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(!s.IsDeleted ? "bg-success" : "bg-danger")">@(!s.IsDeleted ? "Aktif" : "Pasif")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 text-end text-muted">Toplam <strong>@Model.Soforler.Count</strong> servis</div>
                }
            }
            else if (sekme == ServisRaporSekme.Ogrenciler)
            {
                @if (!Model.Ogrenciler.Any())
                {
                    <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Servise kayıtlı öğrenci bulunamadı.</div>
                }
                else
                {
                    var gruplar = Model.Ogrenciler
                        .GroupBy(o => o.ServisId!.Value)
                        .OrderBy(g => servisSozluk.GetValueOrDefault(g.Key)?.Plaka);

                    @foreach (var g in gruplar)
                    {
                        var sp = servisSozluk.GetValueOrDefault(g.Key);
                        <div class="border rounded-3 mb-3">
                            <div class="bg-body-tertiary border-bottom px-3 py-2 d-flex flex-wrap gap-3 align-items-center small">
                                <span class="fw-bold text-primary"><i class="bi bi-bus-front"></i> @(sp?.Plaka ?? "-")</span>
                                <span><span class="fw-semibold">Şoför:</span> @(sp?.SoforAdSoyad ?? sp?.Kullanici?.KullaniciAdi ?? "-")
                                    @if (!string.IsNullOrEmpty(sp?.Kullanici?.Telefon)) { <span class="text-muted">(@sp.Kullanici.Telefon)</span> }
                                </span>
                                <span><span class="fw-semibold">Hostes:</span> @(sp?.HostesAdSoyad ?? "-")</span>
                                <span class="ms-auto badge bg-info">@g.Count() öğrenci</span>
                            </div>
                            <table class="table table-hover table-sm align-middle text-center mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:60px;">#</th>
                                        <th class="text-start">Ad Soyad</th>
                                        <th>Öğrenci No</th>
                                        <th>Sınıf/Birim</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var sira = 1; }
                                    @foreach (var o in g)
                                    {
                                        <tr>
                                            <td class="text-secondary">@(sira++)</td>
                                            <td class="text-start fw-semibold">@o.OgrenciAdSoyad</td>
                                            <td>@o.OgrenciNo</td>
                                            <td>@(o.Birim?.BirimAd ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="text-end text-muted">Toplam <strong>@Model.Ogrenciler.Count</strong> öğrenci</div>
                }
            }
            else
            {
                var liste = Model.Yoklamalar!;
                @if (!liste.Any())
                {
                    <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Kayıt bulunamadı.</div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="table table-hover table-sm align-middle text-center">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th class="text-start">Adı Soyadı</th>
                                    <th>Sınıfı</th>
                                    <th>Tarih</th>
                                    <th>Periyot</th>
                                    <th>Durum</th>
                                    <th>Plaka</th>
                                    <th>Şoför</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sv in liste)
                                {
                                    <tr>
                                        <td class="text-start">@sv.Ogrenci?.OgrenciAdSoyad</td>
                                        <td>@sv.Ogrenci?.Birim?.BirimAd</td>
                                        <td>@sv.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@(sv.Periyot == 1 ? "Sabah" : (sv.Periyot == 2 ? "Akşam" : sv.Periyot.ToString()))</td>
                                        <td>
                                            <span class="badge @YoklamaRenkleri.CssServisGetir(sv.DurumId)">@YoklamaMetinleri.ServisMetinGetir(sv.DurumId)</span>
                                        </td>
                                        <td>@(sv.Kullanici?.ServisProfil?.Plaka ?? "-")</td>
                                        <td>@(sv.Kullanici?.ServisProfil?.SoforAdSoyad ?? sv.Kullanici?.KullaniciAdi ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @await Html.PartialAsync("_SayfalamaFormPartial", SayfalamaVm.Olustur(liste,
                        routeValues: new Dictionary<string, string?>
                        {
                            ["sekme"] = sekme,
                            ["servisId"] = Model.ServisId?.ToString(),
                            ["searchString"] = q,
                            ["startDate"] = Model.StartDate,
                            ["endDate"] = Model.EndDate
                        }))
                }
            }
        </div>
    </div>
</div>
